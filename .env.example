# ---------------------------------------------------------------------------
# Baloona — environment variables
# Copy to `.env` (git-ignored) and fill in real values. In Conductor, keep the
# filled-in copy at `$CONDUCTOR_ROOT_PATH/.env` — every workspace inherits it.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled connection string from the Neon dashboard. Used by the app at runtime
# and by `drizzle-kit` for migrations.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/baloona?sslmode=require"

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-char-random-string"
# Public origin of the deployment, no trailing slash. REQUIRED in production.
# In local dev, leave it unset: Better Auth infers the origin from the request,
# so login works on whatever port your dev server (or Conductor) picks.
# BETTER_AUTH_URL="https://your-domain.com"

# Owner account created by `bun run db:seed`. Public sign-up is disabled, so
# this is the only way the first admin is created. Additional users are then
# invited from the admin panel (ניהול צוות).
ADMIN_EMAIL="owner@baloona.co.il"
ADMIN_PASSWORD="change-me-at-least-8-chars"
ADMIN_NAME="מנהל בלונה"

# --- Email (Resend) ---------------------------------------------------------
# Lead notifications are sent to the address configured per location in the
# admin panel (הגדרות כלליות → כתובת לקבלת פניות).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender for outgoing mail.
RESEND_FROM_EMAIL="Baloona <noreply@baloona.co.il>"

# --- Media storage (Cloudflare R2, S3-compatible) ---------------------------
# Optional in development: with these unset, uploads fall back to local disk
# (public/uploads, served at /uploads/...). REQUIRED in production, where the
# filesystem is read-only — set all five below.
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="baloona-media"
# Public base URL of the bucket (r2.dev subdomain or a custom domain), no
# trailing slash. Uploaded files are served from `${R2_PUBLIC_BASE_URL}/<key>`.
R2_PUBLIC_BASE_URL="https://media.baloona.co.il"

# --- AI translation (Google Gemini) -----------------------------------------
# Powers the "מלא עם AI" button that drafts English copy from the Hebrew source.
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Google reviews (Places API) --------------------------------------------
# Each location stores its own Place ID in the admin panel; this key is shared.
GOOGLE_PLACES_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
